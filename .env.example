# AI-Coop Configuration Example

# Git & GitHub Settings
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPO=owner/repo_name
TARGET_REPO_PATH=D:\dev\ai\ai-coop

# Default Agent Engine (antigravity | aider | gemini-cli)
AGENT_TYPE=antigravity

# Antigravity Settings
ANTIGRAVITY_ENABLED=true

# Aider Settings (if AGENT_TYPE=aider)
AIDER_MODEL=gemini/gemini-1.5-pro-latest
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Pipeline Safety Settings
MAX_ITERATIONS=3
AUTO_PUSH=false
AUTO_CREATE_PR=false
TEST_COMMAND=pytest
